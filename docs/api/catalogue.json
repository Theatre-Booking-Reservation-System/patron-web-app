d":true},"responses":{"200":{"description":"Performance updated","content":{"*/*":{"schema":{"$ref":"#/components/schemas/PerformanceResponse"}}}},"400":{"description":"Invalid request body","content":{"*/*":{"schema":{"$ref":"#/components/schemas/PerformanceResponse"}}}},"401":{"description":"Missing or invalid JWT","content":{"*/*":{"schema":{"$ref":"#/components/schemas/PerformanceResponse"}}}},"404":{"description":"No performance exists for the given id","content":{"*/*":{"schema":{"$ref":"#/components/schemas/PerformanceResponse"}}}}}},"delete":{"tags":["Performances"],"summary":"Delete a performance","description":"Deletes an existing performance identified by its UUID.","operationId":"deletePerformance","parameters":[{"name":"id","in":"path","description":"Unique identifier of the performance","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"204":{"description":"Performance deleted"},"401":{"description":"Missing or invalid JWT"},"404":{"description":"No performance exists for the given id"}}}},"/productions":{"get":{"tags":["Productions"],"summary":"List all productions","description":"Returns every production in the catalogue.","operationId":"getAllProductions","responses":{"200":{"description":"Productions returned","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProductionListResponse"}}}},"401":{"description":"Missing or invalid JWT","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProductionListResponse"}}}}}},"post":{"tags":["Productions"],"summary":"Create a production","description":"Creates a new production. The authenticated user is recorded as the creator.","operationId":"createProduction","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ProductionRequest"}}},"required":true},"responses":{"201":{"description":"Production created","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProductionResponse"}}}},"400":{"description":"Invalid request body","content":{"*/*":