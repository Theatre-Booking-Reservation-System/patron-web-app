gle production","required":false,"schema":{"type":"string","format":"uuid"}},{"name":"dateFrom","in":"query","description":"Inclusive lower bound on date (use today for 'Today's Shows')","required":false,"schema":{"type":"string","format":"date"}},{"name":"dateTo","in":"query","description":"Inclusive upper bound on date (use today for 'Today's Shows')","required":false,"schema":{"type":"string","format":"date"}},{"name":"sessionType","in":"query","description":"Session type filter: MATINEE or EVENING","required":false,"schema":{"type":"string","enum":["MATINEE","EVENING"]}},{"name":"status","in":"query","description":"Exact status filter: 1=Active, 9=Inactive/Archived","required":false,"schema":{"type":"integer","format":"int32"}}],"responses":{"200":{"description":"Matching performances returned","content":{"*/*":{"schema":{"$ref":"#/components/schemas/PerformanceSearchResponse"}}}},"401":{"description":"Missing or invalid JWT","content":{"*/*":{"schema":{"$ref":"#/components/schemas/PerformanceSearchResponse"}}}}}}}},"components":{"schemas":{"ProductionRequest":{"type":"object","properties":{"titleEn":{"type":"string"},"titleSi":{"type":"string"},"titleTa":{"type":"string"},"language":{"type":"string","enum":["SINHALA","TAMIL","ENGLISH"]},"genre":{"type":"string"},"descriptionEn":{"type":"string"},"descriptionSi":{"type":"string"},"descriptionTa":{"type":"string"},"baseTicketCost":{"type":"number"},"releaseDate":{"type":"string","format":"date"},"endDate":{"type":"string","format":"date"},"posterImageUrl":{"type":"string"},"status":{"type":"integer","format":"int32"}}},"ProductionResponse":{"type":"object","properties":{"statusCode":{"type":"string"},"statusDescription":{"type":"string"},"productionId":{"type":"string","format":"uuid"},"titleEn":{"type":"string"},"titleSi":{"type":"string"},"titleTa":{"type":"string"},"language":{"type":"string","enum":["SINHALA","TAMIL","ENGLISH"]},"genre":{"type":"string"},"descriptionEn":{"type":"string"},"descriptionSi":{"typ