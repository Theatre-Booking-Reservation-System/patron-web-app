{"openapi":"3.1.0","info":{"title":"Booking Service API","description":"Creation, lookup and cancellation of theatre bookings for the Theatre Booking & Reservation System.","contact":{"name":"Theatre Platform Team"},"license":{"name":"Apache 2.0"},"version":"v1"},"servers":[{"url":"/","description":"Current host"}],"security":[{"bearerAuth":[]}],"tags":[{"name":"Bookings","description":"Create, look up and cancel theatre bookings"}],"paths":{"/bookings/{id}/cancel":{"put":{"tags":["Bookings"],"summary":"Cancel a booking","description":"Cancels an existing booking identified by its UUID. Paid bookings are marked for refund. Already-cancelled or expired bookings cannot be cancelled again.","operationId":"cancelBooking","parameters":[{"name":"id","in":"path","description":"Unique identifier of the booking","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"Booking cancelled","content":{"*/*":{"schema":{"$ref":"#/components/schemas/BookingResponse"}}}},"401":{"description":"Missing or invalid JWT","content":{"*/*":{"schema":{"$ref":"#/components/schemas/BookingResponse"}}}},"404":{"description":"No booking exists for the given id","content":{"*/*":{"schema":{"$ref":"#/components/schemas/BookingResponse"}}}},"409":{"description":"Booking cannot be cancelled in its current state","content":{"*/*":{"schema":{"$ref":"#/components/schemas/BookingResponse"}}}}}}},"/bookings":{"post":{"tags":["Bookings"],"summary":"Create a booking","description":"Creates a new booking with its seat lines. The booking is created in PENDING status with UNPAID payment. Totals are aggregated from the supplied lines.","operationId":"createBooking","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/BookingRequest"}}},"required":true},"responses":{"201":{"description":"Booking created","content":{"*/*":{"schema":{"$ref":"#/components/schemas/BookingResponse"}}}},"400":{"description":"Invalid booking request","content":{"*