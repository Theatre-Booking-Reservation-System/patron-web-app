{"openapi":"3.1.0","info":{"title":"Booking Service API","description":"Creation, lookup and cancellation of theatre bookings for the Theatre Booking & Reservation System.","contact":{"name":"Theatre Platform Team"},"license":{"name":"Apache 2.0"},"version":"v1"},"servers":[{"url":"/","description":"Current host"}],"security":[{"bearerAuth":[]}],"tags":[{"name":"Bookings","description":"Create, look up and cancel theatre bookings"}],"paths":{"/bookings/{id}/cancel":{"put":{"tags":["Bookings"],"summary":"Cancel a booking","description":"Cancels an existing booking identified by its UUID. Paid bookings are marked for refund. Already-cancelled or expired bookings cannot be cancelled again.","operationId":"cancelBooking","parameters":[{"name":"id","in":"path","description":"Unique identifier of the booking","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"Booking cancelled","content":{"*/*":{"schema":{"$ref":"#/components/schemas/BookingResponse"}}}},"401":{"description":"Missing or invalid JWT","content":{"*/*":{"schema":{"$ref":"#/components/schemas/BookingResponse"}}}},"404":{"description":"No booking exists for the given id","content":{"*/*":{"schema":{"$ref":"#/components/schemas/BookingResponse"}}}},"409":{"description":"Booking cannot be cancelled in its current state","content":{"*/*":{"schema":{"$ref":"#/components/schemas/BookingResponse"}}}}}}},"/bookings":{"post":{"tags":["Bookings"],"summary":"Create a booking","description":"Creates a CONFIRMED booking for the authenticated registered patron. Payment is simulated; only the card's last four digits are retained. Returns a QR-encoded confirmation with the production name, performance date/time, seats and total.","operationId":"createBooking","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/BookingRequest"}}},"required":true},"responses":{"201":{"description":"Booking created","content":{"*/*":{"schema":{"$ref":"#/components/schemas/BookingResponse"}}}},"400":{"description":"Invalid booking request","content":{"*/*":{"schema":{"$ref":"#/components/schemas/BookingResponse"}}}},"401":{"description":"Missing or invalid JWT / not a registered user","content":{"*/*":{"schema":{"$ref":"#/components/schemas/BookingResponse"}}}},"402":{"description":"Payment authorisation failed","content":{"*/*":{"schema":{"$ref":"#/components/schemas/BookingResponse"}}}},"409":{"description":"One or more selected seats are already booked","content":{"*/*":{"schema":{"$ref":"#/components/schemas/BookingResponse"}}}}}}},"/performances/{id}/bookings":{"get":{"tags":["Bookings"],"summary":"List booked seats for a performance","description":"Returns the seats already booked for a performance (from active bookings). Consumed by seat-service to derive per-seat availability.","operationId":"getBookingsByPerformanceId","parameters":[{"name":"id","in":"path","description":"Unique identifier of the performance","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"Booked seats returned","content":{"*/*":{"schema":{"$ref":"#/components/schemas/PerformanceBookedSeatsResponse"}}}},"401":{"description":"Missing or invalid JWT","content":{"*/*":{"schema":{"$ref":"#/components/schemas/PerformanceBookedSeatsResponse"}}}}}}},"/patrons/{id}/bookings":{"get":{"tags":["Bookings"],"summary":"List bookings for a patron","description":"Returns all bookings placed by the given patron, most recent first.","operationId":"getBookingsByPatronId","parameters":[{"name":"id","in":"path","description":"Unique identifier of the patron","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"Bookings returned","content":{"*/*":{"schema":{"$ref":"#/components/schemas/BookingListResponse"}}}},"401":{"description":"Missing or invalid JWT","content":{"*/*":{"schema":{"$ref":"#/components/schemas/BookingListResponse"}}}}}}},"/bookings/{ref}":{"get":{"tags":["Bookings"],"summary":"Get a booking by reference","description":"Returns a single booking identified by its human-readable booking reference (e.g. STB-20260913-00847), including its seats.","operationId":"getBookingByRef","parameters":[{"name":"ref","in":"path","description":"Human-readable booking reference","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Booking found","content":{"*/*":{"schema":{"$ref":"#/components/schemas/BookingResponse"}}}},"401":{"description":"Missing or invalid JWT","content":{"*/*":{"schema":{"$ref":"#/components/schemas/BookingResponse"}}}},"404":{"description":"No booking exists for the given reference","content":{"*/*":{"schema":{"$ref":"#/components/schemas/BookingResponse"}}}}}}}},"components":{"schemas":{"BookingResponse":{"type":"object","properties":{"statusCode":{"type":"string"},"statusDescription":{"type":"string"},"bookingId":{"type":"string","format":"uuid"},"bookingRef":{"type":"string"},"patronId":{"type":"string","format":"uuid"},"performanceId":{"type":"string","format":"uuid"},"productionName":{"type":"string"},"performanceDate":{"type":"string","format":"date"},"performanceTime":{"type":"string","format":"time-local"},"seats":{"type":"array","items":{"$ref":"#/components/schemas/BookingSeatItem"}},"ticketType":{"type":"string","enum":["REGULAR","GROUP","LOYALTY"]},"totalLkr":{"type":"number"},"status":{"type":"string","enum":["PENDING","CONFIRMED","CANCELLED_PATRON","CANCELLED_ADMIN","EXPIRED"]},"paymentStatus":{"type":"string","enum":["UNPAID","PAID","REFUNDED","FAILED"]},"cardLast4":{"type":"string"},"createdAt":{"type":"string","format":"date-time"},"qrCode":{"type":"string"}}},"BookingSeatItem":{"type":"object","properties":{"seatId":{"type":"string","format":"uuid"},"seatRef":{"type":"string"},"zoneName":{"type":"string"},"section":{"type":"string"}}},"BookingRequest":{"type":"object","properties":{"patronId":{"type":"string","format":"uuid"},"performanceId":{"type":"string","format":"uuid"},"seats":{"type":"array","items":{"$ref":"#/components/schemas/SeatSelection"}},"ticketType":{"type":"string","enum":["REGULAR","GROUP","LOYALTY"]},"paymentMethod":{"type":"string","enum":["CREDIT_CARD","DEBIT_CARD","EWALLET","BANK_TRANSFER"]},"paymentDetails":{"$ref":"#/components/schemas/PaymentDetails"}}},"PaymentDetails":{"type":"object","properties":{"cardNumber":{"type":"string"},"expiry":{"type":"string"},"cvv":{"type":"string"},"cardHolderName":{"type":"string"}}},"SeatSelection":{"type":"object","properties":{"seatId":{"type":"string","format":"uuid"},"seatRef":{"type":"string"},"zoneName":{"type":"string"},"section":{"type":"string"}}},"PerformanceBookedSeatsResponse":{"type":"object","properties":{"statusCode":{"type":"string"},"statusDescription":{"type":"string"},"performanceId":{"type":"string","format":"uuid"},"bookedSeatIds":{"type":"array","items":{"type":"string","format":"uuid"}},"bookedSeatRefs":{"type":"array","items":{"type":"string"}}}},"BookingItem":{"type":"object","properties":{"bookingId":{"type":"string","format":"uuid"},"bookingRef":{"type":"string"},"performanceId":{"type":"string","format":"uuid"},"seats":{"type":"array","items":{"$ref":"#/components/schemas/BookingSeatItem"}},"ticketType":{"type":"string","enum":["REGULAR","GROUP","LOYALTY"]},"status":{"type":"string","enum":["PENDING","CONFIRMED","CANCELLED_PATRON","CANCELLED_ADMIN","EXPIRED"]},"paymentStatus":{"type":"string","enum":["UNPAID","PAID","REFUNDED","FAILED"]},"totalLkr":{"type":"number"},"createdAt":{"type":"string","format":"date-time"}}},"BookingListResponse":{"type":"object","properties":{"statusCode":{"type":"string"},"statusDescription":{"type":"string"},"bookings":{"type":"array","items":{"$ref":"#/components/schemas/BookingItem"}}}}},"securitySchemes":{"bearerAuth":{"type":"http","description":"JWT access token issued by the Identity Service. Use the format: Bearer <token>","name":"bearerAuth","scheme":"bearer","bearerFormat":"JWT"}}}}