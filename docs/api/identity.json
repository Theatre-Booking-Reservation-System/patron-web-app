{"openapi":"3.1.0","info":{"title":"Identity Service API","description":"Authentication and patron account management for the Theatre Booking & Reservation System. Issues JWT access tokens used by the other services.","contact":{"name":"Theatre Platform Team"},"license":{"name":"Apache 2.0"},"version":"v1"},"servers":[{"url":"/","description":"Current host"}],"tags":[{"name":"Authentication","description":"Login and JWT access-token issuance"},{"name":"Patrons","description":"Self-service patron account registration"}],"paths":{"/patron/{patronId}/unlock":{"post":{"tags":["Patrons"],"summary":"Unlock a locked patron account","description":"Clears any active lock and resets the failed-login counter for the given patron, letting them log in again immediately. Idempotent. Restricted to admins.","operationId":"unlockPatron","parameters":[{"name":"patronId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"Patron account unlocked","content":{"*/*":{"schema":{"$ref":"#/components/schemas/CommonResponse"}}}},"401":{"description":"Missing or invalid authentication","content":{"*/*":{"schema":{"$ref":"#/components/schemas/CommonResponse"}}}},"403":{"description":"Caller is not an admin","content":{"*/*":{"schema":{"$ref":"#/components/schemas/CommonResponse"}}}},"404":{"description":"No patron exists for the given id","content":{"*/*":{"schema":{"$ref":"#/components/schemas/CommonResponse"}}}}}}},"/patron/{patronId}/loyalty":{"post":{"tags":["Patrons"],"summary":"Enrol a patron in the loyalty programme","description":"Generates a loyalty card number and flags the patron as a loyalty holder. Fails if the patron is already enrolled. Available to admins and to the patron themselves.","operationId":"enrollLoyalty","parameters":[{"name":"patronId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"Patron enrolled; loyalty id returned","content":{"*/*":{"schema":{"$ref":"#/components/schemas/LoyaltyEnrollResponse"}}}},"401":{"description":"Missing or invalid authentication","content":{"*/*":{"schema":{"$ref":"#/components/schemas/LoyaltyEnrollResponse"}}}},"403":{"description":"Caller is neither an admin nor a patron","content":{"*/*":{"schema":{"$ref":"#/components/schemas/LoyaltyEnrollResponse"}}}},"404":{"description":"No patron exists for the given id","content":{"*/*":{"schema":{"$ref":"#/components/schemas/LoyaltyEnrollResponse"}}}},"409":{"description":"Patron is already a loyalty member","content":{"*/*":{"schema":{"$ref":"#/components/schemas/LoyaltyEnrollResponse"}}}}}}},"/patron/register":{"post":{"tags":["Patrons"],"summary":"Register a new patron account","description":"Creates a new patron with the supplied name, email and password. This is a public endpoint and does not require authentication.","operationId":"register","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/PatronRegisterRequest"}}},"required":true},"responses":{"201":{"description":"Patron account created","content":{"*/*":{"schema":{"$ref":"#/components/schemas/PatronRegisterResponse"}}}},"400":{"description":"Request body failed validation","content":{"*/*":{"schema":{"$ref":"#/components/schemas/PatronRegisterResponse"}}}},"409":{"description":"A patron with the given email already exists","content":{"*/*":{"schema":{"$ref":"#/components/schemas/PatronRegisterResponse"}}}}}}},"/auth/login":{"post":{"tags":["Authentication"],"summary":"Authenticate a user and issue a JWT","description":"Validates the supplied credentials and, on success, returns a JWT access token together with the authenticated user's profile. This is a public endpoint and does not require authentication.","operationId":"login","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/LoginRequest"}}},"required":true},"responses":{"200":{"description":"Authentication succeeded; access token returned","content":{"*/*":{"schema":{"$ref":"#/components/schemas/LoginResponse"}}}},"400":{"description":"Request body failed validation","content":{"*/*":{"schema":{"$ref":"#/components/schemas/LoginResponse"}}}},"401":{"description":"Invalid credentials","content":{"*/*":{"schema":{"$ref":"#/components/schemas/LoginResponse"}}}},"423":{"description":"Account temporarily locked after too many failed attempts","content":{"*/*":{"schema":{"$ref":"#/components/schemas/LoginResponse"}}}}}}},"/patron/{patronId}":{"get":{"tags":["Patrons"],"summary":"Get a single patron's details","description":"Returns the details of one patron by id. Intended for the admin portal; requires authentication.","operationId":"getPatron","parameters":[{"name":"patronId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"Patron found","content":{"*/*":{"schema":{"$ref":"#/components/schemas/PatronDetailResponse"}}}},"401":{"description":"Missing or invalid authentication","content":{"*/*":{"schema":{"$ref":"#/components/schemas/PatronDetailResponse"}}}},"403":{"description":"Caller is neither an admin nor a patron","content":{"*/*":{"schema":{"$ref":"#/components/schemas/PatronDetailResponse"}}}},"404":{"description":"No patron exists for the given id","content":{"*/*":{"schema":{"$ref":"#/components/schemas/PatronDetailResponse"}}}}}}},"/patron/search":{"get":{"tags":["Patrons"],"summary":"Search patrons by filters","description":"Returns patrons matching any combination of the optional filters (name, email, loyaltyHolder, status). Name and email are matched case-insensitively as a partial 'contains'. Omitting all filters returns every patron. Intended for the admin portal; requires authentication.","operationId":"searchPatrons","parameters":[{"name":"name","in":"query","required":false,"schema":{"type":"string"}},{"name":"email","in":"query","required":false,"schema":{"type":"string"}},{"name":"loyaltyHolder","in":"query","required":false,"schema":{"type":"boolean"}},{"name":"status","in":"query","required":false,"schema":{"type":"integer","format":"int32"}}],"responses":{"200":{"description":"Matching patrons returned","content":{"*/*":{"schema":{"$ref":"#/components/schemas/PatronListResponse"}}}},"401":{"description":"Missing or invalid authentication","content":{"*/*":{"schema":{"$ref":"#/components/schemas/PatronListResponse"}}}},"403":{"description":"Caller is not an admin","content":{"*/*":{"schema":{"$ref":"#/components/schemas/PatronListResponse"}}}}}}},"/patron/list":{"get":{"tags":["Patrons"],"summary":"List all registered patrons","description":"Returns every patron account as a read-only summary, most recently registered first. Intended for the admin portal; requires authentication.","operationId":"listPatrons","responses":{"200":{"description":"Patron list returned","content":{"*/*":{"schema":{"$ref":"#/components/schemas/PatronListResponse"}}}},"401":{"description":"Missing or invalid authentication","content":{"*/*":{"schema":{"$ref":"#/components/schemas/PatronListResponse"}}}},"403":{"description":"Caller is not an admin","content":{"*/*":{"schema":{"$ref":"#/components/schemas/PatronListResponse"}}}}}}}},"components":{"schemas":{"CommonResponse":{"type":"object","properties":{"statusCode":{"type":"string"},"statusDescription":{"type":"string"}}},"LoyaltyEnrollResponse":{"type":"object","properties":{"statusCode":{"type":"string"},"statusDescription":{"type":"string"},"patronId":{"type":"string","format":"uuid"},"loyaltyCardNo":{"type":"string"}}},"PatronRegisterRequest":{"type":"object","properties":{"name":{"type":"string","minLength":1},"email":{"type":"string","format":"email","minLength":1},"contactNo":{"type":"string","pattern":"^[0-9+()\\-\\s]{7,20}$"},"dateOfBirth":{"type":"string","format":"date"},"nicPassportNo":{"type":"string","minLength":1,"pattern":"^([0-9]{9}[vVxX]|[0-9]{12}|[A-Za-z0-9]{6,15})$"},"password":{"type":"string","maxLength":2147483647,"minLength":8}},"required":["dateOfBirth","email","name","nicPassportNo","password"]},"PatronRegisterResponse":{"type":"object","properties":{"statusCode":{"type":"string"},"statusDescription":{"type":"string"},"patronId":{"type":"string","format":"uuid"},"email":{"type":"string"}}},"LoginRequest":{"type":"object","properties":{"email":{"type":"string","format":"email","minLength":1},"password":{"type":"string","minLength":1}},"required":["email","password"]},"LoginResponse":{"type":"object","properties":{"statusCode":{"type":"string"},"statusDescription":{"type":"string"},"accessToken":{"type":"string"},"tokenType":{"type":"string"},"expiresIn":{"type":"integer","format":"int64"},"userId":{"type":"string","format":"uuid"},"name":{"type":"string"},"email":{"type":"string"},"role":{"type":"string"}}},"PatronDetailResponse":{"type":"object","properties":{"statusCode":{"type":"string"},"statusDescription":{"type":"string"},"patron":{"$ref":"#/components/schemas/PatronSummary"}}},"PatronSummary":{"type":"object","properties":{"patronId":{"type":"string","format":"uuid"},"name":{"type":"string"},"email":{"type":"string"},"contactNo":{"type":"string"},"dateOfBirth":{"type":"string","format":"date"},"nicPassportNo":{"type":"string"},"verified":{"type":"boolean"},"loyaltyCardNo":{"type":"string"},"loyaltyHolder":{"type":"boolean"},"status":{"type":"integer","format":"int32"},"addedDate":{"type":"string","format":"date-time"}}},"PatronListResponse":{"type":"object","properties":{"statusCode":{"type":"string"},"statusDescription":{"type":"string"},"totalCount":{"type":"integer","format":"int64"},"patrons":{"type":"array","items":{"$ref":"#/components/schemas/PatronSummary"}}}}},"securitySchemes":{"bearerAuth":{"type":"http","description":"Provide the JWT access token returned by POST /auth/login using the format: Bearer <token>","name":"bearerAuth","scheme":"bearer","bearerFormat":"JWT"}}}}